# ==============================================================================
# GBICH'APP — Variables d'Environnement Globales (Docker Compose & Local)
# ==============================================================================

PROJECT_NAME="GBICH'APP"
ENVIRONMENT="development"
DEBUG=True

# Backend & API
API_PORT=8000
API_HOST=0.0.0.0
ALLOWED_ORIGINS="http://localhost:8081,http://localhost:3000,http://127.0.0.1:8081,http://localhost:80,http://127.0.0.1:80"

# Frontend Expo Web / PWA
EXPO_PORT=8081
EXPO_PUBLIC_API_URL="http://localhost:8000/api/v1"

# PostgreSQL 16
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=gbich_user
POSTGRES_PASSWORD=gbich_dev_password
POSTGRES_DB=gbich_db

# Redis 7.2
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# MinIO / S3 Object Storage
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_dev_secret_key
MINIO_BUCKET_NAME=gbich-media
MINIO_SECURE=False

# Sécurité & JWT (Secrets locaux de dev)
SECRET_KEY=gbich-insecure-development-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Nginx
NGINX_PORT=80
