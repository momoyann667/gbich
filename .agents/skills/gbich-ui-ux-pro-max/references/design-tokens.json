  "typography": {
    "fonts": {
      "headline": {
        "family": "Anton, sans-serif",
        "usage": "Titres satiriques percutants, Une du journal, scores géants, caricatures",
        "weights": ["400"],
        "lineHeights": {
          "tight": "1.0",
          "normal": "1.1"
        },
        "letterSpacing": "0.02em"
      },
      "body": {
        "family": "Inter, sans-serif",
        "usage": "Textes de lecture, corps des articles, décryptages EMI, paragraphes",
        "weights": ["400", "500", "600", "700"],
        "lineHeights": {
          "relaxed": "1.6",
          "normal": "1.4"
        }
      },
      "label": {
        "family": "Space Grotesk, sans-serif",
        "usage": "Boutons, badges, filtres, micro-copie, chronomètres, scores, tags",
        "weights": ["500", "600", "700"],
        "letterSpacing": "0.04em"
      }
    }
  },
  "radii": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "pill": 9999
  },
  "shadows": {
    "subtle": "0 2px 8px rgba(23, 20, 22, 0.08)",
    "card": "0 10px 24px -4px rgba(23, 20, 22, 0.12)",
    "elevated": "0 20px 32px -8px rgba(23, 20, 22, 0.24)",
    "glowRed": "0 0 20px rgba(245, 34, 45, 0.35)"
  },
  "animation": {
    "durations": {
      "instant": "100ms",
      "fast": "200ms",
      "normal": "350ms",
      "slow": "600ms",
      "complex": "1000ms"
    },
    "easings": {
      "punchy": "cubic-bezier(0.16, 1, 0.3, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "smooth": "cubic-bezier(0.4, 0, 0.2, 1)",
      "bounce": "cubic-bezier(0.68, -0.6, 0.32, 1.6)"
    }
  }
}
