# ==============================================================================
# GBICH'APP — Variables d'Environnement Backend (Développement Local)
# ==============================================================================

PROJECT_NAME="GBICH'APP API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Serveur & Hôte
HOST="0.0.0.0"
PORT=8000
ALLOWED_ORIGINS=["http://localhost:8081","http://localhost:3000","http://127.0.0.1:8081","http://localhost:80","http://127.0.0.1:80"]

# PostgreSQL 16
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="gbich_user"
POSTGRES_PASSWORD="gbich_dev_password"
POSTGRES_DB="gbich_db"

# Redis 7.2
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# MinIO / S3 Object Storage
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minio_admin"
MINIO_SECRET_KEY="minio_dev_secret_key"
MINIO_BUCKET_NAME="gbich-media"
MINIO_SECURE=False

# Sécurité & JWT (Valeurs de dev - À remplacer impérativement en production)
SECRET_KEY="gbich-insecure-development-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
